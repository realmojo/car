# 로컬 개발용 환경변수 예시.
# 이 파일을 .dev.vars 로 복사한 뒤 실제 값을 채우세요 (.dev.vars 는 커밋되지 않습니다).
# 배포 환경에서는 Cloudflare 대시보드 Workers & Pages > car > Settings > Variables and Secrets 에서 설정합니다.

# 한국석유공사 오피넷 무료 API 키 (https://www.opinet.co.kr/user/custapi/openApiInfo.do)
OPINET_API_KEY=""

# 공공데이터포털 일반 인증키(Decoding 값) - 한국환경공단_전기자동차 충전소 정보
# (https://www.data.go.kr/data/15076352/openapi.do)
DATA_GO_KR_SERVICE_KEY=""

# 사이트 기준 URL
NEXT_PUBLIC_BASE_URL="https://car.kimgoon.kr"

# API 키 없이 화면을 확인할 때만 1 로 설정 (가짜 데이터 사용)
MOCK_DATA=""
