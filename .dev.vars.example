# 로컬 개발용 환경변수 예시.
# 이 파일을 .dev.vars 로 복사한 뒤 실제 값을 채우세요 (.dev.vars 는 커밋되지 않습니다).
# 배포 환경에서는 Cloudflare 대시보드 Workers & Pages > car > Settings > Variables and Secrets 에서 설정합니다.

# 공공데이터포털 일반 인증키 (Decoding/Encoding 모두 가능)
#  - 실시간: 한국환경공단_전기자동차 충전소 정보
#  - 동기화: 전국주차장정보표준데이터 등 (scripts/sync-data.ts)
DATA_GO_KR_SERVICE_KEY=""

# 국가교통정보센터(ITS) 인증키 - 돌발상황·CCTV (https://www.its.go.kr/opendata)
# ITS 사이트에서 서비스별로(돌발상황정보, CCTV 화상자료 …) 이용 신청을 해야 한다.
ITS_API_KEY=""
# 선택: CCTV 영상 종류 (4: HTTPS 스트리밍, 1: HTTP 스트리밍). 기본 4, 결과가 없으면 1 로 다시 조회
# ITS_CCTV_TYPE="4"
# 선택: 재난상황정보·주의운전구간 요청 주소 (ITS 오픈데이터 상세 페이지의 요청 URL 에서 ? 앞부분)
# 넣으면 재난상황은 돌발상황 목록에 합쳐지고, 주의운전구간 탭이 생긴다.
# ITS_DISASTER_URL=""
# ITS_CAUTION_URL=""

# 한국도로공사 고속도로 공공데이터 포털 인증키 - 휴게소 동기화 (https://data.ex.co.kr)
EX_API_KEY=""

# 사이트 기준 URL
NEXT_PUBLIC_BASE_URL="https://car.kimgoon.kr"

# API 키 없이 화면을 확인할 때만 1 로 설정 (실시간 API 대신 가짜 데이터)
MOCK_DATA=""

# 동기화 원본 주소를 바꿀 때 (선택). 공공데이터포털 상세 페이지의 "요청주소"를 넣는다.
# SYNC_URL_REPAIR=""
# SYNC_URL_INSPECTION=""
# SYNC_URL_HYDROGEN=""
# SYNC_URL_RECALL=""
# SYNC_URL_EFFICIENCY=""
